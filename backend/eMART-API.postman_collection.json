              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"4242424242424242\",\n  \"cardHolderName\": \"RISHI CHHALOTRE\",\n  \"expiry\": \"12/29\",\n  \"cvv\": \"123\",\n  \"amount\": 62997.9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }

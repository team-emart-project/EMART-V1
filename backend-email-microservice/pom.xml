<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>backend-email-microservice</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend-email-microservice</name>
	<description>e-MART notification service - sends order confirmation and invoice emails</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!--
			DELIBERATELY MINIMAL.

			The Spring Initializr scaffold came with data-jpa, mysql-connector
			and security. All three are gone:

			  * JPA + MySQL - this service owns NO data. It receives an order
			    payload over HTTP, renders it and sends it. Giving it a
			    connection to the shared `emart` database would couple it back
			    to the very schema it is supposed to be independent of, and
			    would make it fail to start whenever MySQL is down - for a
			    service that does not need a single row.

			  * spring-boot-starter-security - the only thing to protect here
			    is one endpoint behind one shared secret. A 40-line
			    OncePerRequestFilter (ApiKeyAuthFilter) does that without
			    pulling in the whole filter chain, and it works identically
			    whether the caller is Java or .NET.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- JavaMailSender + the SMTP auto-configuration behind spring.mail.* -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Renders the HTML invoice. Templates live in
		     src/main/resources/templates/email/ and are never served over HTTP;
		     they are rendered to a String and handed to the mail message. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- @Valid on the inbound payload: a bad request from either backend
		     must fail loudly at the edge, not halfway through building an email. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- /actuator/health, so the callers can check the service is up before
		     (or instead of) discovering it the hard way at checkout time. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Turns emart.email.* into IDE auto-complete for EmailProperties. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>

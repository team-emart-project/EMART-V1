    "Points": {
      // e-Points EARNING: tiered 2%-5% of order value, rounded DOWN.
      // Only ACTIVE cardholders earn.
      //
      //   under  5,000       ->  2%
      //    5,000 -  24,999   ->  3%
      //   25,000 -  74,999   ->  4%
      //   75,000 and above   ->  5%
      "Earn": {
        "Tier1Limit": 5000,
        "Tier2Limit": 25000,
        "Tier3Limit": 75000,
        "Tier1Percentage": 2,
        "Tier2Percentage": 3,
        "Tier3Percentage": 4,

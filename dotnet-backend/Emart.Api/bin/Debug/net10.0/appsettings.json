  // MySQL, not SQL Server and not SQLite. This points at the SAME `emart`
  // database the Java backend uses, so the schema and seed data in
  // backend/emart_schema.sql + emart_seed_data.sql are the single source of
  // truth. EF never creates or migrates these tables.
  //
  // SslMode=Preferred, not Disabled: MySQL 8/9 authenticate with
  // caching_sha2_password, and over an encrypted connection the password
  // exchange needs no RSA key handshake at all. That is what makes
  // AllowPublicKeyRetrieval (and the "Public Key Retrieval is not allowed"
  // failure the Java datasource has to work around) unnecessary here.
  //
  // Note the value is `Preferred`, not `None` — MySql.Data's SslMode enum has
  // no None member, and an unknown value fails while EF is building the
  // provider, which surfaces as a 500 on the first request rather than at startup.
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=emart;user=root;password=Rishi@2003;SslMode=Preferred;"
  },

  "Jwt": {
    "SecretKey": "super_secret_key_that_is_at_least_32_characters_long_for_hmac_sha256",
    "Issuer": "EmartApi",
    "Audience": "EmartClients",
    "ExpirationMinutes": 120
  },

